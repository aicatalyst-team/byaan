# All-in-one self-hosted Byaan container (UBI / OpenShift compatible)
# Includes: PostgreSQL 15, Python backend, Caddy reverse proxy, built frontend
#
# OpenShift deployment requires the "anyuid" SCC because the entrypoint manages
# PostgreSQL (su - postgres, initdb, chown) and starts Supervisor as root.
# The backend process itself runs as unprivileged user "byaan" via Supervisor.
#
#   oc adm policy add-scc-to-user anyuid -z <service-account> -n <namespace>

# =============================================================================
# Stage 1: Frontend build
# =============================================================================
FROM registry.access.redhat.com/ubi9/nodejs-22 AS frontend-builder

USER 0
WORKDIR /build

ARG VITE_IS_HOSTED
ARG VITE_IS_SELF_HOSTED

RUN npm install -g pnpm@10.18.3

COPY client/package*.json client/pnpm-lock.yaml* /build/client/
WORKDIR /build/client
RUN pnpm install --frozen-lockfile

COPY client/ /build/client/
RUN pnpm exec vite --version && pnpm build

# =============================================================================
# Stage 2: Python dependency build
# =============================================================================
FROM registry.access.redhat.com/ubi9/python-312 AS python-builder

USER 0
WORKDIR /app

RUN dnf install -y \
    gcc \
    gcc-c++ \
    make \
    libpq-devel \
    libffi-devel \
    python3.12-devel \
    unixODBC-devel \
    && dnf clean all

COPY --from=ghcr.io/astral-sh/uv:0.11.3 /uv /usr/local/bin/uv

COPY pyproject.toml uv.lock /app/

ENV UV_HTTP_TIMEOUT=300
RUN UV_LINK_MODE=copy uv sync --frozen --no-install-project --python /usr/bin/python3.12

# =============================================================================
# Stage 3: Runtime image
# =============================================================================
FROM registry.access.redhat.com/ubi9/python-312

USER 0
WORKDIR /opt/app-root/src

# ---------- Install EPEL + PostgreSQL 15 repo in one layer ---------------------
RUN dnf install -y \
    https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm \
    https://download.postgresql.org/pub/repos/yum/reporpms/EL-9-x86_64/pgdg-redhat-repo-latest.noarch.rpm \
    && dnf config-manager --set-disabled pgdg14 pgdg16 pgdg17 pgdg18 || true \
    && dnf remove -y libpq-devel || true \
    && dnf clean all

# ---------- Install all runtime dependencies in a single layer -----------------
RUN dnf install -y --allowerasing \
    libpq \
    curl \
    pango \
    gdk-pixbuf2 \
    libffi-devel \
    shared-mime-info \
    cairo \
    glib2 \
    gnupg2 \
    supervisor \
    gettext \
    openssl \
    postgresql15-server \
    postgresql15 \
    unixODBC \
    procps-ng \
    && dnf clean all

# ---------- Install Caddy via direct binary download ---------------------------
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "x86_64" ]; then CADDY_ARCH="amd64"; \
    elif [ "$ARCH" = "aarch64" ]; then CADDY_ARCH="arm64"; \
    else CADDY_ARCH="amd64"; fi && \
    curl -fsSL "https://caddyserver.com/api/download?os=linux&arch=${CADDY_ARCH}" -o /usr/local/bin/caddy \
    && chmod +x /usr/local/bin/caddy

# ---------- Install MS ODBC driver for SQL Server (optional) -------------------
RUN curl -fsSL https://packages.microsoft.com/config/rhel/9/prod.repo > /etc/yum.repos.d/mssql-release.repo \
    && ACCEPT_EULA=Y dnf install -y msodbcsql18 || true \
    && dnf clean all

# ---------- Install uv --------------------------------------------------------
COPY --from=ghcr.io/astral-sh/uv:0.11.3 /uv /usr/local/bin/uv

# ---------- Copy built artifacts -----------------------------------------------

# Copy pre-built frontend
COPY --from=frontend-builder /build/client/dist /opt/app-root/src/client/dist

# Copy pre-built Python venv and server code
COPY --from=python-builder /app/.venv /opt/app-root/src/.venv
COPY pyproject.toml uv.lock /opt/app-root/src/
COPY server/ /opt/app-root/src/server/

# Pre-compile Python bytecode
RUN .venv/bin/python -m compileall -q /opt/app-root/src/server/ || true

# ---------- Self-hosted config files -------------------------------------------
RUN mkdir -p /etc/supervisor/conf.d /etc/caddy

COPY docker/self-hosted/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY docker/self-hosted/Caddyfile.template /etc/caddy/Caddyfile.template
COPY docker/self-hosted/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY docker/self-hosted/start-backend.sh /opt/app-root/src/start-backend.sh

RUN chmod +x /usr/local/bin/entrypoint.sh /opt/app-root/src/start-backend.sh

# ---------- Adapt all paths for UBI layout (single sed layer) ------------------

# Patch entrypoint.sh:
#   - PostgreSQL binaries: /usr/lib/postgresql/15/bin -> /usr/pgsql-15/bin
#   - App directory: /app -> /opt/app-root/src
#   - Default port: 80 -> 8080 (OpenShift non-privileged)
RUN sed -i \
    -e 's|PG_BIN="/usr/lib/postgresql/15/bin"|PG_BIN="/usr/pgsql-15/bin"|g' \
    -e 's|/app/client/dist|/opt/app-root/src/client/dist|g' \
    -e 's|/app/server/\.data|/opt/app-root/src/server/.data|g' \
    -e 's|/app/server|/opt/app-root/src/server|g' \
    -e 's|/app/start-backend\.sh|/opt/app-root/src/start-backend.sh|g' \
    -e 's|/app/\.data|/opt/app-root/src/.data|g' \
    -e 's|/app/client|/opt/app-root/src/client|g' \
    -e 's|DOMAIN=":80"|DOMAIN=":8080"|g' \
    /usr/local/bin/entrypoint.sh \
    && sed -i \
    -e 's|/app/client/dist|/opt/app-root/src/client/dist|g' \
    /etc/caddy/Caddyfile.template \
    && sed -i \
    -e 's|/usr/lib/postgresql/15/bin/postgres|/usr/pgsql-15/bin/postgres|g' \
    -e 's|/app/start-backend.sh|/opt/app-root/src/start-backend.sh|g' \
    -e 's|directory=/app/server|directory=/opt/app-root/src/server|g' \
    -e 's|directory=/app|directory=/opt/app-root/src|g' \
    -e 's|PYTHONPATH="/app"|PYTHONPATH="/opt/app-root/src"|g' \
    -e 's|/usr/bin/caddy|/usr/local/bin/caddy|g' \
    /etc/supervisor/conf.d/supervisord.conf \
    && sed -i \
    -e 's|cd /app/server|cd /opt/app-root/src/server|g' \
    -e 's|cd /app|cd /opt/app-root/src|g' \
    /opt/app-root/src/start-backend.sh

# ---------- Create users and directories (single layer) -----------------------

RUN useradd --create-home --shell /bin/bash byaan \
    && mkdir -p /var/lib/pgsql \
    && chown postgres:postgres /var/lib/pgsql \
    && usermod -d /var/lib/pgsql postgres 2>/dev/null || true

RUN mkdir -p /data/postgres /data/uploads /data/backups /data/logs \
    /data/claude /data/app_data/datasets \
    /home/byaan/.cache/uv \
    /run/postgresql \
    /var/run/supervisor \
    /var/log/supervisor \
    && chown -R postgres:postgres /data/postgres /run/postgresql \
    && chown -R byaan:byaan /data/uploads /data/backups \
       /data/logs /data/claude /data/app_data /home/byaan \
    && chmod -R a+rX /opt/app-root/src

# ---------- Environment variables ----------------------------------------------

ENV PYTHONPATH=/opt/app-root/src \
    DATA_DIR=/data \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    APP_MODE=self-hosted \
    BYAAN_DEFAULT_LLM_PROVIDER=openai \
    BYAAN_DEFAULT_LLM_MODEL=gpt-4o-mini

# ENCRYPTION_KEY and OPENAI_API_KEY must be provided at runtime via K8s secret/configmap

# ---------- OpenShift compatibility --------------------------------------------
# Group 0 (root group) permissions enable arbitrary UID support.
# Apply g=u selectively — avoid recursing into the massive .venv tree.

RUN chgrp -R 0 /opt/app-root/src/server /opt/app-root/src/client \
        /opt/app-root/src/start-backend.sh \
        /opt/app-root/src/pyproject.toml /opt/app-root/src/uv.lock \
        /data /etc/caddy /etc/supervisor \
        /run/postgresql /var/run/supervisor /var/log/supervisor \
        /home/byaan /var/lib/pgsql \
    && chmod -R g=u /opt/app-root/src/server /opt/app-root/src/client \
        /opt/app-root/src/start-backend.sh \
        /opt/app-root/src/pyproject.toml /opt/app-root/src/uv.lock \
        /data /etc/caddy /etc/supervisor \
        /run/postgresql /var/run/supervisor /var/log/supervisor \
        /home/byaan /var/lib/pgsql \
    && chmod g=u /etc/passwd

# Expose non-privileged HTTP port (Caddy reverse proxy)
EXPOSE 8080

# Volume for persistent data (PostgreSQL, uploads, backups)
VOLUME ["/data"]

# This container requires root for PostgreSQL management (su - postgres, initdb,
# chown) and Supervisor.  On OpenShift use the "anyuid" SCC.
# The backend process itself runs as unprivileged "byaan" user via Supervisor.
# We do NOT set USER 1001 because the entrypoint needs root privileges.

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
